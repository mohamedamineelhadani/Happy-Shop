# Base path for the HappyShop API. Leave empty to use the Vite dev proxy (/api).
# In production set this to the full backend URL, e.g. https://api.happyshop.test/api
VITE_API_BASE_URL=

VITE_STORE_URL=http://localhost:5173

# Where the Vite dev proxy forwards /api requests.
VITE_API_TARGET=http://localhost:8000

VITE_MEDIA_TARGET=http://localhost:8000/public
