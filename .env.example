# Copy this file to ".env" and adjust if your setup differs.

# Where the Vite dev server proxies "/api" requests (the PHP backend).
VITE_API_TARGET=http://localhost/Portfolio%20projects/happyChop/backend

# Only needed for a production build where the front-end and API are served from
# different origins. Leave empty in development so the proxy is used.
VITE_API_BASE_URL=
