RewriteEngine On

# Forward the Authorization header to PHP (Apache strips it by default).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Send every request that is not a real file or directory to index.php.
# No RewriteBase is used so the API keeps working wherever the project lives.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Disable directory listing.
Options -Indexes

# Never serve source or data files.
<FilesMatch "\.(sql|log|ini|md|json)$">
    Require all denied
</FilesMatch>
